# Configuración de Base de Datos
# Para SQLite local:
# DATABASE_URL=sqlite:///./solensa.db
# Para PostgreSQL en IBM Cloud (ejemplo):
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd?sslmode=require

DATABASE_URL=sqlite:///./solensa.db

# Entorno (development, production, testing)
ENVIRONMENT=development

# IBM Watson Credentials (para F6)
# WATSON_API_KEY=tu-api-key
# WATSON_URL=https://api.us-south.watson.cloud.ibm.com
# WATSON_PROJECT_ID=tu-project-id