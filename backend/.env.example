# Configuración de Base de Datos
# Para SQLite local:
# DATABASE_URL=sqlite:///./solensa.db
# Para PostgreSQL en IBM Cloud (ejemplo):
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd?sslmode=require

DATABASE_URL=sqlite:///./solensa.db

# Entorno (development, production, testing)
ENVIRONMENT=development

# IBM Watson Discovery (RAG)
# WATSON_DISCOVERY_API_KEY=tu-api-key
# WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
# WATSON_DISCOVERY_PROJECT_ID=tu-project-id
# WATSON_DISCOVERY_COLLECTION_ID=tu-collection-id